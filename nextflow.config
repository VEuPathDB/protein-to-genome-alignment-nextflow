params {
  queryFilePath = "$baseDir/data/query.fa"
  targetFilePath = "$baseDir/data/genome.fa"
  outputDir = "$launchDir/data"
  outputFileName = "nrProteinToGenome.gff"
  queryChunkSize = 100
  esd2esiMemoryLimit = 2048
  fsmmemory = 2048
  maxintron = 5000
}
docker.enabled = true

includeConfig "$baseDir/conf/lsf.config"
includeConfig "$baseDir/conf/processResources.conf"
